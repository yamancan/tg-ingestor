# Deny files by default. Only reviewed source/documentation paths are publishable.
# Keep directory traversal enabled so the explicit file exceptions can be found.
*
!*/
!/.gitignore
!/README.md
!/SECURITY.md
!/REVIEW.md
!/LICENSE
!/LICENSE.*
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/skills/**/SKILL.md
!/skills/**/agents/openai.yaml
!/skills/**/scripts/*.py
!/skills/**/references/*.md
!/tests/test_*.py
!/tests/fixtures/conversation.json
!/.github/workflows/*.yml
!/.github/workflows/*.yaml

# Private data and generated artifacts stay excluded even under allowed trees.
data/
output/
exports/
packages/
chunks/
summaries/
drafts/
ChatExport*/
result.json
messages*.html
context.md
INDEX.md
*.jsonl

# Local tools, caches, environments and credentials are never publication inputs.
.agents/
.codex/
.idea/
.vscode/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
build/
dist/
*.egg-info/
*.py[cod]
.DS_Store
.env
.env.*
*.pem
*.key
*.session
*.session-journal
*.log
